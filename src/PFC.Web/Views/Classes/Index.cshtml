@model IReadOnlyList<GymClass>
@{
    ViewData["Title"] = "Classes";
    ViewData["Description"] = "Boxing, MMA, Muay Thai, strength and grappling classes for all levels at PFC Cape Town.";
}
<section class="section">
    <div class="wrap">
        <div class="section-head">
            <p class="eyebrow">Training programmes</p>
            <h2>All classes</h2>
            <p class="lead">
                Find the perfect class for your goals and experience level.
                Every class is open to members on any plan.
            </p>
        </div>
        <div class="grid grid--3">
            @foreach (var gymClass in Model)
            {
                <partial name="_ClassCard" model="gymClass" />
            }
        </div>
    </div>
</section>
