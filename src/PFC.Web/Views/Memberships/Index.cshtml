@model MembershipsViewModel
@{
    ViewData["Title"] = "Memberships";
}
<section class="section">
    <div class="wrap">
        @if (Model.CurrentPlan is not null)
        {
            <div class="section-head">
                <p class="eyebrow">Your account</p>
                <h2>Your membership</h2>
                <p class="lead">You are on the R@(Model.CurrentPlan.PricePerMonth.ToString("0")) plan.</p>
            </div>
            <div class="plans">
                <partial name="_PlanCard" model="Model.CurrentPlan" />
            </div>
            <div class="section-head" style="margin-top:56px">
                <h2>Change your plan</h2>
            </div>
            <div class="plans">
                @foreach (var plan in Model.Plans.Where(p => p.Id != Model.CurrentPlan.Id))
                {
                    <partial name="_PlanCard" model="plan" />
                }
            </div>
        }
        else
        {
            <div class="section-head">
                <p class="eyebrow">Pricing</p>
                <h2>Join PFC</h2>
                <p class="lead">
                    @(Model.IsStaff
                        ? "Staff accounts have full facility access — no membership needed."
                        : "Cancel or upgrade anytime. All plans include full facility access.")
                </p>
            </div>
            <div class="plans">
                @foreach (var plan in Model.Plans)
                {
                    <partial name="_PlanCard" model="plan" />
                }
            </div>
        }
    </div>
</section>