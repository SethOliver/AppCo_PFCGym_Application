@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}
<div class="dash">
    <aside class="dash__side">
        <a class="btn btn--red btn--sm" asp-controller="Dashboard" asp-action="Index" aria-current="page">Dashboard</a>
        <div class="dash__user">
            <span class="dash__avatar" aria-hidden="true">@Model.Initials</span>
            <span><b>@Model.MemberName</b><span>Member</span></span>
        </div>
    </aside>

    <div class="dash__main">
        <div class="wrap">
            <div class="section-head section-head--row">
                <div>
                    <p class="eyebrow">Account</p>
                    <h2>Your membership</h2>
                </div>
                <a class="pill-link" asp-controller="Account" asp-action="SignOut">Sign out</a>
            </div>

            <div class="dash-grid dash-grid--2">
                @if (Model.CurrentPlan is not null)
                {
                    <article class="plan plan--pop" style="order:0">
                        <p class="plan__badge">Current plan</p>
                        <p class="plan__price">
                            <sup>R</sup>@Model.CurrentPlan.PricePerMonth.ToString("0")<small>/ mo</small>
                        </p>
                        <ul>
                            @foreach (var feature in Model.CurrentPlan.Features)
                            {
                                <li>@feature</li>
                            }
                        </ul>
                        <a class="btn btn--grey btn--block" asp-controller="Memberships" asp-action="Index">
                            Upgrade membership
                        </a>
                    </article>
                }

                <div class="dash-grid">
                    <article class="dash-card">
                        <p class="eyebrow">Next class</p>
                        @if (Model.NextClass is not null)
                        {
                            <h3 style="font-size:20px;margin-top:4px">@Model.NextClass.ClassName</h3>
                            <p style="color:var(--mut);margin-top:6px">
                                @Model.NextClass.Day @Model.NextClass.StartsAt.ToString("HH\\:mm")
                                with @Model.NextClass.CoachName
                            </p>
                        }
                        else
                        {
                            <p style="color:var(--mut);margin-top:6px">Nothing booked yet.</p>
                        }
                        <a class="btn btn--red btn--block btn--sm" asp-controller="Timetable" asp-action="Index"
                           style="margin-top:16px">View timetable</a>
                    </article>

                    <article class="dash-card">
                        <p class="eyebrow">This month</p>
                        <p style="font-size:40px;font-weight:900;letter-spacing:-.03em;margin-top:4px">
                            @Model.ClassesThisMonth
                        </p>
                        <p style="color:var(--mut)">classes attended</p>
                    </article>

                    <article class="dash-card">
                        <p class="eyebrow">Billing</p>
                        <p style="color:var(--mut);margin-top:6px">
                            Next payment @Model.NextPaymentDate.ToString("d MMMM yyyy")
                        </p>
                        <button class="btn btn--line btn--block btn--sm" type="button" style="margin-top:16px">
                            Cancel membership
                        </button>
                    </article>
                </div>
            </div>
        </div>
    </div>
</div>
