@model CoachDashboardViewModel
@{
    ViewData["Title"] = "Coach dashboard";
}
<div class="dash">
    <aside class="dash__side">
        <a class="btn btn--red btn--sm" asp-controller="Dashboard" asp-action="Index" aria-current="page">Dashboard</a>
        <div class="dash__user">
            <span class="dash__avatar" aria-hidden="true">@Model.Initials</span>
            <span><b>@Model.CoachName</b><span>Coach</span></span>
        </div>
    </aside>
    <div class="dash__main">
        <div class="wrap">
            <div class="section-head">
                <p class="eyebrow">Today</p>
                <h2>Your classes</h2>
            </div>
            @if (!Model.TodaysClasses.Any())
            {
                <p class="lead">Nothing scheduled today.</p>
            }
            @foreach (var slot in Model.TodaysClasses)
            {
                <div class="slot">
                    <p class="slot__time"><b>@slot.StartsAt.ToString("HH\\:mm")</b><span>@slot.DurationMinutes min</span></p>
                    <p class="slot__info"><b>@slot.ClassName</b><span>@slot.Booked of @slot.Capacity booked</span></p>
                    <span class="tag">@slot.SpacesLeft left</span>
                </div>
            }
            <div class="section-head" style="margin-top:48px"><h2>Your week</h2></div>
            @foreach (var slot in Model.WeeklyClasses)
            {
                <div class="slot @(slot.IsFull ? "slot__full" : "")">
                    <p class="slot__time"><b>@slot.StartsAt.ToString("HH\\:mm")</b><span>@slot.Day.ToString().Substring(0, 3)</span></p>
                    <p class="slot__info"><b>@slot.ClassName</b><span>@slot.Booked of @slot.Capacity booked</span></p>
                </div>
            }
        </div>
    </div>
</div>