@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin dashboard";
}
<div class="dash">
    <aside class="dash__side">
        <a class="btn btn--red btn--sm" asp-controller="Dashboard" asp-action="Index" aria-current="page">Dashboard</a>
        <div class="dash__user">
            <span class="dash__avatar" aria-hidden="true">@Model.Initials</span>
            <span><b>@Model.AdminName</b><span>Administrator</span></span>
        </div>
    </aside>
    <div class="dash__main">
        <div class="wrap">
            <div class="section-head">
                <p class="eyebrow">Overview</p>
                <h2>Admin</h2>
            </div>
            <div class="stats" style="margin-bottom:40px">
                <div><b>@Model.TotalMembers</b><span>Members</span></div>
                <div><b>@Model.TotalCoaches</b><span>Coaches</span></div>
                <div><b>@Model.TotalClasses</b><span>Classes</span></div>
                <div><b>@Model.WeeklySlots</b><span>Weekly slots</span></div>
                <div><b>@Model.FullSlots</b><span>Fully booked</span></div>
            </div>
            <div class="section-head"><h2>Users</h2></div>
            @foreach (var user in Model.Users)
            {
                <div class="slot">
                    <p class="slot__time" style="flex:0 0 44px">
                        <span class="dash__avatar" style="width:36px;height:36px;font-size:12px">@user.Initials</span>
                    </p>
                    <p class="slot__info"><b>@user.FullName</b><span>@user.Email</span></p>
                    <span class="tag">@user.Role</span>
                </div>
            }
        </div>
    </div>
</div>