@{
    ViewData["Title"] = "Fight events";
}
<section class="auth">
    <div style="text-align:center;max-width:460px">
        <div class="auth__logo" aria-hidden="true">PFC</div>
        <h1 style="font-size:32px">Fight events</h1>
        <p class="lead" style="margin-inline:auto">
            Fight cards, tickets and results live on the PFC promotions site. It opens in a new tab.
        </p>
        <div style="display:flex;flex-direction:column;gap:10px;margin-top:28px">
            <a class="btn btn--red" href="#" target="_blank" rel="noopener">Open promotions site &#8599;</a>
            <a class="btn btn--line" asp-controller="Home" asp-action="Index">Back to website</a>
        </div>
    </div>
</section>
