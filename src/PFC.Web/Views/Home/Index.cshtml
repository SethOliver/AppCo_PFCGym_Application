@model HomeViewModel
@{
    ViewData["Title"] = "Home";
    ViewData["Description"] = "Elite boxing, MMA and strength training in Bothasig, Cape Town. Championship coaching for every level.";
}

<section class="hero">
    <img class="hero__bg" src="~/images/hero.jpg" alt="" aria-hidden="true"
         fetchpriority="high" width="1200" height="675" />
    <div class="wrap">
        <h1>Professional <em>Fighting</em> Championship</h1>
        <p class="hero__sub">
            Elite boxing, MMA and strength training under world-class coaches.
            Your journey to the top starts here.
        </p>
        <div class="hero__cta">
            <a class="btn btn--red" asp-controller="Memberships" asp-action="Index">Join now &rarr;</a>
            <a class="btn btn--ghost" asp-controller="Home" asp-action="Promo">Fight events</a>
        </div>
        <dl class="hero__meta">
            <div>
                <dt>Today</dt>
                <dd>
                    @Model.TodayHours
                    <span class="status-open" style="@(Model.IsOpenNow ? "" : "color:var(--mut-2)")">
                        @(Model.IsOpenNow ? "• Open" : "• Closed")
                    </span>
                </dd>
            </div>
            <div><dt>Location</dt><dd>Bothasig, Cape Town</dd></div>
            <div><dt>From</dt><dd class="price">R@(Model.CheapestPlan.ToString("0"))/mo</dd></div>
        </dl>
    </div>
</section>

<section class="section">
    <div class="wrap">
        <div class="section-head section-head--row">
            <div>
                <p class="eyebrow">Training programmes</p>
                <h2>Our<br />classes</h2>
            </div>
            <a class="pill-link" asp-controller="Classes" asp-action="Index">View all &rarr;</a>
        </div>
        <div class="scroller">
            @foreach (var gymClass in Model.FeaturedClasses)
            {
                <partial name="_ClassCard" model="gymClass" view-data='new ViewDataDictionary(ViewData) { ["ShowBook"] = false }' />
            }
        </div>
    </div>
</section>

<section class="section section--tight">
    <div class="wrap">
        <div class="section-head section-head--row">
            <div>
                <p class="eyebrow">Expert coaching</p>
                <h2>Meet our<br />coaches</h2>
            </div>
            <a class="pill-link" asp-controller="Coaches" asp-action="Index">View all &rarr;</a>
        </div>
        <div class="scroller">
            @foreach (var coach in Model.FeaturedCoaches)
            {
                <partial name="_CoachCard" model="coach" />
            }
        </div>
    </div>
</section>

<section class="stats">
    <div><b>@Model.ActiveMembers+</b><span>Active members</span></div>
    <div><b>@Model.CoachCount</b><span>Expert coaches</span></div>
    <div><b>@Model.WeeklyClasses+</b><span>Weekly classes</span></div>
    <div><b>@Model.AmateurChampions+</b><span>Amateur champions</span></div>
    <div><b>@Model.YearsOperating</b><span>Years operating</span></div>
</section>

<section class="section">
    <div class="wrap">
        <div class="section-head section-head--row">
            <div>
                <p class="eyebrow">Pricing</p>
                <h2>Choose<br />your plan</h2>
            </div>
            <a class="pill-link" asp-controller="Memberships" asp-action="Index">Membership page &rarr;</a>
        </div>
        <div class="plans">
            @foreach (var plan in Model.Plans)
            {
                <partial name="_PlanCard" model="plan" />
            }
        </div>
    </div>
</section>

<section class="section section--tight">
    <div class="wrap">
        <div class="section-head">
            <p class="eyebrow">Reviews</p>
            <h2>What members say</h2>
        </div>
        <div class="grid grid--2">
            @foreach (var review in Model.Reviews)
            {
                <figure class="quote reveal">
                    <p class="stars" aria-label="@review.Rating out of 5 stars">
                        @for (var i = 0; i < review.Rating; i++)
                        {
                            <text>&#9733;</text>
                        }
                    </p>
                    <blockquote><p>@review.Body</p></blockquote>
                    <figcaption>
                        <span class="av" aria-hidden="true">@review.Initials</span>
                        <span><b>@review.MemberName</b><time>@review.TimeAgo</time></span>
                    </figcaption>
                </figure>
            }
        </div>
    </div>
</section>

<section class="section">
    <div class="wrap">
        <div class="section-head">
            <p class="eyebrow">The facility</p>
            <h2>Inside PFC</h2>
            <p class="lead">
                Two full rings, a dedicated bag floor, mat space for grappling
                and a complete strength area.
            </p>
        </div>
        <div class="gallery">
            @for (var i = 1; i <= 6; i++)
            {
                <img src="~/images/gallery-@(i).jpg" alt="Inside the PFC facility, view @i"
                     loading="lazy" width="900" height="900" />
            }
        </div>
    </div>
</section>

<section class="cta-band">
    <img src="~/images/cta-ring.jpg" alt="" aria-hidden="true" loading="lazy" width="1200" height="525" />
    <div class="wrap">
        <h2>Your first session<br />is on us</h2>
        <p class="lead" style="margin-inline:auto">
            Come in, meet the coaches and try a class before you commit to anything.
        </p>
        <a class="btn btn--red" asp-controller="Contact" asp-action="Index">Book a free trial</a>
    </div>
</section>
