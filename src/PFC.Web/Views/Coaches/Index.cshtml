@model IReadOnlyList<Coach>
@{
    ViewData["Title"] = "Coaches";
    ViewData["Description"] = "Meet the PFC coaching team: championship boxers, national Muay Thai champions and BJJ black belts.";
}
<section class="section">
    <div class="wrap">
        <div class="section-head">
            <p class="eyebrow">Expert coaching</p>
            <h2>Our coaches</h2>
            <p class="lead">World-class coaches committed to your performance and growth.</p>
        </div>
        <div class="grid grid--3">
            @foreach (var coach in Model)
            {
                <partial name="_CoachCard" model="coach" />
            }
        </div>
    </div>
</section>
