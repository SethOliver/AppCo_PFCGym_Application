@model ContactForm
@{
    ViewData["Title"] = "Contact";
    ViewData["Description"] = "Get in touch with PFC in Bothasig, Cape Town. Book a free trial session.";
}
<section class="section">
    <div class="wrap">
        <div class="section-head">
            <p class="eyebrow">Get in touch</p>
            <h2>Contact us</h2>
            <p class="lead">Ready to start your journey? We'd love to hear from you.</p>
        </div>

        <form class="form form--split" method="post" data-validate novalidate>
            <div class="field">
                <label asp-for="Name"></label>
                <input asp-for="Name" data-rule="name" placeholder="Your full name" autocomplete="name" />
                <span class="error" role="alert" asp-validation-for="Name"></span>
            </div>
            <div class="field">
                <label asp-for="Email"></label>
                <input asp-for="Email" data-rule="email" placeholder="your@@gmail.com" autocomplete="email" />
                <span class="error" role="alert" asp-validation-for="Email"></span>
            </div>
            <div class="field">
                <label asp-for="Phone">Phone <span style="text-transform:none;letter-spacing:0">(optional)</span></label>
                <input asp-for="Phone" data-rule="phone" placeholder="+27 …" autocomplete="tel" />
                <span class="error" role="alert" asp-validation-for="Phone"></span>
            </div>
            <div class="field field--full">
                <label asp-for="Message"></label>
                <textarea asp-for="Message" data-rule="message" placeholder="Tell us about your goals…"></textarea>
                <span class="error" role="alert" asp-validation-for="Message"></span>
            </div>
            <div class="field--full">
                <partial name="_ValidationSummary" />
            </div>
            <div class="field--full">
                <button class="btn btn--red btn--block" type="submit" data-label="Send message">Send message</button>
                <p class="form-note" style="margin-top:12px">We usually reply within one working day.</p>
            </div>
        </form>
    </div>
</section>
