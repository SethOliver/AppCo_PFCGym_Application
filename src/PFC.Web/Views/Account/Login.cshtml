@model LoginForm
@{
    ViewData["Title"] = "Login";
}
<section class="auth">
    <div class="auth__card">
        <div class="auth__logo" aria-hidden="true">PFC</div>
        <h1>Welcome back</h1>

        <form class="form" method="post" data-validate novalidate>
            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

            <div class="field">
                <label asp-for="Email"></label>
                <input asp-for="Email" data-rule="email" placeholder="your@@gmail.com" autocomplete="email" />
                <span class="error" role="alert" asp-validation-for="Email"></span>
            </div>
            <div class="field">
                <label asp-for="Password"></label>
                <div class="field__row">
                    <input asp-for="Password" id="l-pw" data-rule="password"
                           placeholder="••••••••" autocomplete="current-password" />
                    <button class="toggle-pw" type="button" data-target="l-pw" aria-label="Show password">Show</button>
                </div>
                <span class="error" role="alert" asp-validation-for="Password"></span>
                <p style="text-align:right;margin-top:8px">
                    <a href="#" style="font-size:11px;color:var(--red);font-weight:700">Forgot password?</a>
                </p>
            </div>

            @if (ViewData.ModelState[string.Empty]?.Errors.Count > 0)
            {
                <p class="alert alert--err is-shown" role="alert">
                    @ViewData.ModelState[string.Empty]!.Errors.First().ErrorMessage
                </p>
            }
            else
            {
                <partial name="_ValidationSummary" />
            }

            <button class="btn btn--red btn--block" type="submit" data-label="Sign in">Sign in</button>
        </form>

        <p class="auth__alt">
            Not a member? <a asp-controller="Account" asp-action="Register">Join PFC</a>
        </p>
    </div>
</section>