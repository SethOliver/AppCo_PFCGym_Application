@model RegisterForm
@{
    ViewData["Title"] = "Register";
    var plans = ViewBag.Plans as IReadOnlyList<MembershipPlan> ?? new List<MembershipPlan>();
}
<section class="auth">
    <div class="auth__card">
        <div class="auth__logo" aria-hidden="true">PFC</div>
        <h1>Join PFC</h1>

        <form class="form" method="post" data-validate novalidate>
            <div class="field">
                <label asp-for="Name"></label>
                <input asp-for="Name" data-rule="name" placeholder="Your full name" autocomplete="name" />
                <span class="error" role="alert" asp-validation-for="Name"></span>
            </div>
            <div class="field">
                <label asp-for="Email"></label>
                <input asp-for="Email" data-rule="email" placeholder="your@@gmail.com" autocomplete="email" />
                <span class="error" role="alert" asp-validation-for="Email"></span>
            </div>
            <div class="field">
                <label asp-for="Phone"></label>
                <input asp-for="Phone" data-rule="phone" placeholder="+27 …" autocomplete="tel" />
                <span class="error" role="alert" asp-validation-for="Phone"></span>
            </div>
            <div class="field">
                <label asp-for="PlanId"></label>
                <select asp-for="PlanId">
                    <option value="">Choose a plan</option>
                    @foreach (var plan in plans)
                    {
                        <option value="@plan.Id">R@(plan.PricePerMonth.ToString("0")) / month</option>
                    }
                </select>
                <span class="error" role="alert" asp-validation-for="PlanId"></span>
            </div>
            <div class="field">
                <label asp-for="Password"></label>
                <div class="field__row">
                    <input asp-for="Password" id="r-pw" data-rule="password"
                           placeholder="At least 8 characters" autocomplete="new-password" />
                    <button class="toggle-pw" type="button" data-target="r-pw" aria-label="Show password">Show</button>
                </div>
                <span class="error" role="alert" asp-validation-for="Password"></span>
            </div>
            <partial name="_ValidationSummary" />
            <button class="btn btn--red btn--block" type="submit" data-label="Create account">Create account</button>
        </form>

        <p class="auth__alt">
            Already a member? <a asp-controller="Account" asp-action="Login">Log in</a>
        </p>
    </div>
</section>
