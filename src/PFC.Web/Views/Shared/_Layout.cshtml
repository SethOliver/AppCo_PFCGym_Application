@inject IGymDataService Data
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Home";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";

    var nav = new (string Controller, string Action, string Label)[]
    {
        ("Home", "Index", "Home"),
        ("Classes", "Index", "Classes"),
        ("Coaches", "Index", "Coaches"),
        ("Memberships", "Index", "Memberships"),
        ("Timetable", "Index", "Timetable"),
        ("Contact", "Index", "Contact")
    };

    string Current(string c) => controller == c ? "page" : null;

    var showStickyCta = controller is "Home" or "Classes" or "Coaches" or "Timetable";
    var todayHours = Data.GetHoursFor(DateTime.Today.DayOfWeek);
}
<!DOCTYPE html>
<html lang="en-ZA">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] | PFC — Professional Fighting Championship</title>
    <meta name="description" content="@(ViewData["Description"] ?? "Elite boxing, MMA and strength training in Bothasig, Cape Town.")" />
    <meta name="theme-color" content="#000000" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@@400;500;700;800;900&amp;display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main">Skip to main content</a>

    <header class="header">
        <div class="header__inner">
            <a class="logo" asp-controller="Home" asp-action="Index" aria-label="PFC home"><span>PFC</span></a>

            <nav class="nav" aria-label="Main navigation">
                @foreach (var item in nav)
                {
                    <a asp-controller="@item.Controller" asp-action="@item.Action"
                       aria-current="@Current(item.Controller)">@item.Label</a>
                }
            </nav>

            <div class="header__actions">
                <a class="header__login" asp-controller="Account" asp-action="Login">Login</a>
                <a class="btn btn--red btn--sm" asp-controller="Memberships" asp-action="Index">Join now</a>
                <button class="burger" type="button" aria-label="Open menu"
                        aria-expanded="false" aria-controls="navpanel">
                    <span></span><span></span><span></span>
                </button>
            </div>
        </div>
    </header>

    <div class="navpanel" id="navpanel" role="dialog" aria-modal="true" aria-label="Menu">
        <div class="navpanel__top">
            <button class="navpanel__close" type="button" aria-label="Close menu">&times;</button>
        </div>
        <nav class="navpanel__list" aria-label="Mobile navigation">
            @for (var i = 0; i < nav.Length; i++)
            {
                <a asp-controller="@nav[i].Controller" asp-action="@nav[i].Action"
                   aria-current="@Current(nav[i].Controller)">
                    @nav[i].Label<span>@((i + 1).ToString("00"))</span>
                </a>
            }
        </nav>
        <div class="navpanel__cta">
            <a class="btn btn--red" asp-controller="Memberships" asp-action="Index">Join now</a>
            <a class="btn btn--line" asp-controller="Account" asp-action="Login">Log in</a>
        </div>
        <p class="navpanel__meta">
            Open today @todayHours.Display<br />+27 82 670 9027
        </p>
    </div>

    <main id="main">
        @if (TempData["Success"] is string ok)
        {
            <div class="wrap" style="padding-top:20px">
                <p class="alert alert--ok is-shown" role="status">@ok</p>
            </div>
        }
        @if (TempData["Error"] is string bad)
        {
            <div class="wrap" style="padding-top:20px">
                <p class="alert alert--err is-shown" role="alert">@bad</p>
            </div>
        }

        @RenderBody()
    </main>

    <footer class="footer">
        <div class="wrap">
            <a class="logo" asp-controller="Home" asp-action="Index" aria-label="PFC home"
               style="margin-bottom:22px"><span>PFC</span></a>

            <div class="footer__cols">
                <details open>
                    <summary><h4>Navigation</h4></summary>
                    <ul>
                        @foreach (var item in nav)
                        {
                            <li><a asp-controller="@item.Controller" asp-action="@item.Action">@item.Label</a></li>
                        }
                    </ul>
                </details>

                <details>
                    <summary><h4>Opening hours</h4></summary>
                    <dl class="hours">
                        @foreach (var h in Data.GetOpeningHours())
                        {
                            <dt>@h.Day.ToString().Substring(0, 3)</dt>
                            <dd>@h.Display</dd>
                        }
                    </dl>
                </details>

                <details open>
                    <summary><h4>Find us</h4></summary>
                    <ul class="contact-list">
                        <li><span class="ico" aria-hidden="true">&#9679;</span>Bothasig, Cape Town, Western Cape</li>
                        <li><span class="ico" aria-hidden="true">&#9679;</span><a href="tel:+27826709027">+27 82 670 9027</a></li>
                        <li><span class="ico" aria-hidden="true">&#9679;</span><a href="mailto:PFCgroup@@gmail.co.za">PFCgroup@@gmail.co.za</a></li>
                    </ul>
                </details>
            </div>

            <div class="footer__legal">
                <p>&copy; @DateTime.Now.Year Professional Fighting Championship. All rights reserved.</p>
                <nav aria-label="Legal">
                    <a href="#">Privacy Policy</a><a href="#">Terms of Service</a><a href="#">Cookie Policy</a>
                </nav>
            </div>
        </div>
    </footer>

    @if (showStickyCta)
    {
        <div class="sticky-cta">
            <div>
                <small>From</small>
                <b>R@(Data.GetPlans().Min(p => p.PricePerMonth).ToString("0")) / mo</b>
            </div>
            <a class="btn btn--red" asp-controller="Memberships" asp-action="Index">Join now</a>
        </div>
    }

    <script src="~/js/main.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
