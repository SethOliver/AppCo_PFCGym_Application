@model MembershipPlan
<article class="plan @(Model.IsMostPopular ? "plan--pop" : "") reveal">
    @if (Model.IsMostPopular)
    {
        <p class="plan__badge">Most popular</p>
    }
    <p class="plan__price">
        <sup>R</sup>@Model.PricePerMonth.ToString("0")<small>/ mo</small>
    </p>
    <ul>
        @foreach (var feature in Model.Features)
        {
            <li>@feature</li>
        }
    </ul>
    <a class="btn @(Model.IsMostPopular ? "btn--red" : "btn--grey") btn--block"
       asp-controller="Account" asp-action="Register" asp-route-planId="@Model.Id">Get started</a>
</article>
