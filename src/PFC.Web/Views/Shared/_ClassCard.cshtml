@model GymClass
@{
    var showBook = ViewData["ShowBook"] as bool? ?? true;
}
<article class="card reveal">
    <img class="card__media" src="@Url.Content(Model.ImagePath)"
         alt="@Model.Name training area at PFC" loading="lazy" width="800" height="600" />
    <div class="card__body">
        <h3>@Model.Name</h3>
        <p>@Model.Description</p>
        <div class="card__tags">
            <span class="tag">@Model.Level</span>
            <span class="tag">@Model.DurationMinutes min</span>
        </div>
        @if (showBook)
        {
            <a class="btn btn--red btn--block btn--sm" asp-controller="Timetable" asp-action="Index"
               style="margin-top:14px">Book class</a>
        }
    </div>
</article>
