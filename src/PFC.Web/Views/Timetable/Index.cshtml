@model TimetableViewModel
@{
    ViewData["Title"] = "Timetable";
    ViewData["Description"] = "Weekly class timetable for PFC Cape Town. Book a spot up to seven days ahead.";
}
<section class="section">
    <div class="wrap">
        <div class="section-head">
            <p class="eyebrow">Weekly schedule</p>
            <h2>Timetable</h2>
            <p class="lead">
                Book a spot up to seven days ahead. Places are limited and fill
                quickly in the evenings.
            </p>
        </div>

        <div class="days" role="tablist" aria-label="Day of the week">
            @foreach (var day in Model.Days)
            {
                <a class="day" role="tab"
                   asp-controller="Timetable" asp-action="Index" asp-route-day="@day"
                   data-day="@day.ToString().ToLower().Substring(0, 3)"
                   data-full="@day"
                   aria-selected="@(day == Model.SelectedDay ? "true" : "false")">
                    @day.ToString().Substring(0, 3)
                </a>
            }
        </div>

        @foreach (var day in Model.Days)
        {
            <div data-day-panel="@day.ToString().ToLower().Substring(0, 3)" role="tabpanel"
                 hidden="@(day == Model.SelectedDay ? null : "hidden")">
                @if (!Model.SlotsByDay[day].Any())
                {
                    <p class="lead">No classes scheduled on @day.</p>
                }
                @foreach (var slot in Model.SlotsByDay[day])
                {
                    <div class="slot @(slot.IsFull ? "slot__full" : "")">
                        <p class="slot__time">
                            <b>@slot.StartsAt.ToString("HH\\:mm")</b>
                            <span>@slot.DurationMinutes min</span>
                        </p>
                        <p class="slot__info">
                            <b>@slot.ClassName</b>
                            <span>@slot.CoachName</span>
                        </p>
                        @if (slot.IsFull)
                        {
                            <span class="tag">Full</span>
                        }
                        else
                        {
                            <form asp-controller="Timetable" asp-action="Book" method="post">
                                <input type="hidden" name="id" value="@slot.Id" />
                                <input type="hidden" name="day" value="@day" />
                                <button class="btn btn--red btn--sm" type="submit"
                                        aria-label="Book @slot.ClassName at @slot.StartsAt.ToString("HH\\:mm")">
                                    Book
                                </button>
                            </form>
                        }
                    </div>
                }
            </div>
        }

        <p class="form-note" style="text-align:left;margin-top:16px" data-day-label>
            @Model.SelectedDay · @Model.SlotsByDay[Model.SelectedDay].Count
            @(Model.SlotsByDay[Model.SelectedDay].Count == 1 ? "class" : "classes")
        </p>
    </div>
</section>
